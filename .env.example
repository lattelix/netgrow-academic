# Copy this file to .env.local and adjust if your local PostgreSQL differs.
# These are local, password-less development URLs - not secrets. Production
# credentials (e.g. a Neon connection string) are configured on the hosting
# platform, never committed here.

# Used by `pnpm dev`, `pnpm build`, `pnpm start`, and the db:* scripts.
DATABASE_URL=postgresql://localhost:5432/netgrow

# Used by `pnpm test` for the PostgreSQL-backed integration tests
# (src/lib/domain/__tests__). Must point at a separate, disposable database -
# never at DATABASE_URL above.
TEST_DATABASE_URL=postgresql://localhost:5432/netgrow_test

# `pnpm e2e` always uses a `netgrow_e2e` database derived from DATABASE_URL
# (see e2e/global-setup.ts) and resets it before the suite runs; it does not
# read TEST_DATABASE_URL.

# Required by scripts/reset-db.ts and scripts/seed.ts before they will touch
# any database, as a safeguard against running them by accident.
# ALLOW_DB_RESET=1
